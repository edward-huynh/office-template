# Copy to .env to override defaults. Every value is optional in development.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# SQLite database file and the managed storage root (templates/ and documents/ live inside it).
DATABASE_PATH=data/app.db
STORAGE_DIR=storage

# Manifest-driven source catalog. The API imports it on start (idempotent).
CATALOG_DIR=templates

# Set to "false" to skip the import on start and manage templates only through the admin API.
# AUTO_SEED=false

# Worker threads for DOCX/PPTX conversions (0 = run on the main thread).
# DOC_WORKERS=1

MAX_UPLOAD_MB=10

# Required in production. In development the token defaults to "dev-admin-token".
# ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: LibreOffice and pdftoppm are auto-detected on PATH; set these to override.
# SOFFICE_PATH=/usr/bin/soffice
# PDFTOPPM_PATH=/usr/bin/pdftoppm

# Set to "true" when serving over HTTPS so the session cookie gets the Secure flag.
# COOKIE_SECURE=true
